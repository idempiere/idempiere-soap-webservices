<?xml version="1.0" encoding="UTF-8"?>
<classpath>
	<classpathentry kind="con" path="org.eclipse.jdt.launching.JRE_CONTAINER">
		<attributes>
			<attribute name="maven.pomderived" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="con" path="org.eclipse.pde.core.requiredPlugins"/>
	<classpathentry exported="true" kind="lib" path="lib/cxf-core.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/cxf-rt-bindings-soap.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/cxf-rt-bindings-xml.jar"/>
