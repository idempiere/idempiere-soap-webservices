<?xml version="1.0" encoding="UTF-8"?>
<project
    xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.idempiere.soap</groupId>
        <artifactId>org.idempiere.soap.parent</artifactId>
        <version>${revision}</version>
        <relativePath>../org.idempiere.soap.parent/pom.xml</relativePath>
    </parent>

    <artifactId>org.idempiere.webservice.library</artifactId>
    <packaging>eclipse-plugin</packaging>

    <properties>
        <cxf.version>3.6.5</cxf.version>
        <spring.version>5.3.27</spring.version>
        <!-- Apache dropped the XmlBeans data binding and the XmlBeans JAX-RS providers after
             CXF 3.1. iDempiere keeps them alive as repackaged bundles on its own p2 site. -->
        <cxf.repackaged.version>3.6.3</cxf.repackaged.version>
        <cxf.repackaged.url>https://docs.idempiere.org/binary.file/p2.repackaged/12.0.1/plugins</cxf.repackaged.url>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>copy-embedded-jars</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <!-- Apache CXF -->
                                <artifactItem>
                                    <groupId>org.apache.cxf</groupId>
                                    <artifactId>cxf-core</artifactId>
                                    <version>${cxf.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.apache.cxf</groupId>
                                    <artifactId>cxf-rt-bindings-soap</artifactId>
                                    <version>${cxf.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.apache.cxf</groupId>
                                    <artifactId>cxf-rt-bindings-xml</artifactId>
                                    <version>${cxf.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.apache.cxf</groupId>
                                    <artifactId>cxf-rt-databinding-jaxb</artifactId>
                                    <version>${cxf.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.apache.cxf</groupId>
                                    <artifactId>cxf-rt-frontend-jaxrs</artifactId>
                                    <version>${cxf.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.apache.cxf</groupId>
                                    <artifactId>cxf-rt-frontend-jaxws</artifactId>
                                    <version>${cxf.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.apache.cxf</groupId>
                                    <artifactId>cxf-rt-frontend-simple</artifactId>
                                    <version>${cxf.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.apache.cxf</groupId>
                                    <artifactId>cxf-rt-rs-service-description</artifactId>
                                    <version>${cxf.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.apache.cxf</groupId>
                                    <artifactId>cxf-rt-security</artifactId>
                                    <version>${cxf.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.apache.cxf</groupId>
                                    <artifactId>cxf-rt-transports-http</artifactId>
                                    <version>${cxf.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.apache.cxf</groupId>
                                    <artifactId>cxf-rt-ws-addr</artifactId>
                                    <version>${cxf.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.apache.cxf</groupId>
                                    <artifactId>cxf-rt-ws-policy</artifactId>
                                    <version>${cxf.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.apache.cxf</groupId>
                                    <artifactId>cxf-rt-ws-transfer</artifactId>
                                    <version>${cxf.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.apache.cxf</groupId>
                                    <artifactId>cxf-rt-wsdl</artifactId>
                                    <version>${cxf.version}</version>
                                </artifactItem>
                                <!-- CXF support libraries that core does not ship -->
                                <artifactItem>
                                    <groupId>org.apache.neethi</groupId>
                                    <artifactId>neethi</artifactId>
                                    <version>3.2.0</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.apache.ws.xmlschema</groupId>
                                    <artifactId>xmlschema-core</artifactId>
                                    <version>2.3.1</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>wsdl4j</groupId>
                                    <artifactId>wsdl4j</artifactId>
                                    <version>1.6.3</version>
                                </artifactItem>
                                <!-- Spring, required by the CXF bus configuration -->
                                <artifactItem>
                                    <groupId>org.springframework</groupId>
                                    <artifactId>spring-aop</artifactId>
                                    <version>${spring.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.springframework</groupId>
                                    <artifactId>spring-beans</artifactId>
                                    <version>${spring.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.springframework</groupId>
                                    <artifactId>spring-context</artifactId>
                                    <version>${spring.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.springframework</groupId>
                                    <artifactId>spring-context-support</artifactId>
                                    <version>${spring.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.springframework</groupId>
                                    <artifactId>spring-core</artifactId>
                                    <version>${spring.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.springframework</groupId>
                                    <artifactId>spring-expression</artifactId>
                                    <version>${spring.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.springframework</groupId>
                                    <artifactId>spring-web</artifactId>
                                    <version>${spring.version}</version>
                                </artifactItem>
                            </artifactItems>
                            <outputDirectory>lib</outputDirectory>
                            <stripVersion>true</stripVersion>
                            <overWriteReleases>true</overWriteReleases>
                            <overWriteSnapshots>true</overWriteSnapshots>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>fetch-repackaged-jars</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <mkdir dir="lib"/>
                                <get dest="lib/cxf-rt-databinding-xmlbeans.jar" verbose="true" usetimestamp="true"
                                     src="${cxf.repackaged.url}/org.apache.cxf.cxf-rt-databinding-xmlbeans_${cxf.repackaged.version}.jar"/>
                                <get dest="lib/cxf-rt-rs-extension-providers.jar" verbose="true" usetimestamp="true"
                                     src="${cxf.repackaged.url}/org.apache.cxf.cxf-rt-rs-extension-providers_${cxf.repackaged.version}.jar"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
