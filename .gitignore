# ── Tycho / Eclipse PDE ──────────────────────────────────────────────────────
*.class
bin/
local/
p2/

# ── Eclipse workspace & IDE ──────────────────────────────────────────────────
# .project, .classpath and .settings/ are tracked, like in iDempiere core, so the
# plugins can be imported with "Existing Projects into Workspace". Only the per
# developer compiler settings are ignored.
.metadata/
.recommenders/
*.launch
*.bak
*.swp
*.swo
**/org.eclipse.jdt.core.prefs
**/org.sonarlint.eclipse.core.prefs
.loadpath
*.iml
*.iws
*.ipr
.idea/

# ── p2-maven-plugin output (org.idempiere.webservice.client) ─────────────────
# The generated P2 site is a build artifact, not source
org.idempiere.webservice.client/target/

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── org.idempiere.webservice.library ─────────────────────────────────────────
# The embedded jars are downloaded by the build, they are not sources
org.idempiere.webservice.library/lib/*.jar
